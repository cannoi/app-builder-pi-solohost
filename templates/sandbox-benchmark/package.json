{
  "name": "sandbox-app-benchmark",
  "version": "2.0.0",
  "private": true,
  "description": "One-container baseline for qualifying a Podman/Docker sandbox before testing generated web apps.",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "health": "node -e \"require('http').get('http://127.0.0.1:'+(process.env.PORT||8080)+'/health',r=>{let b='';r.on('data',c=>b+=c);r.on('end',()=>{console.log(b);process.exit(r.statusCode===200?0:1)})}).on('error',e=>{console.error(e);process.exit(1)})\""
  }
}
