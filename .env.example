FACTORY_BIND=0.0.0.0
PORT=8080
# Required for API, project, preview, and settings access. Use at least 16 characters.
BUILDER_ACCESS_PASSWORD=
PREVIEW_MODE=auto
# Optional: protected Podman Sandbox API. Leave blank to use built-in preview fallback.
PODMAN_API_URL=
AI_PROVIDER=deepseek
AI_MODE=single
BUILD_TIMEOUT=900
SANDBOX_TIMEOUT=300
MAX_AUTO_FIXES=3
MAX_CONCURRENT_BUILDS=1
MAX_PROJECT_SIZE_MB=80
MAX_LOG_SIZE_MB=10

# Optional Feedback Hub credentials; configure in the private runtime environment.
SHFH_HUB_URL=
SHFH_HUB_ID=
SHFH_INGEST_TOKEN=
